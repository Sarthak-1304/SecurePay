# =============================================
# .env.example — Copy this file to .env and fill in your values
# =============================================
# Command:  copy .env.example .env   (Windows)
#           cp .env.example .env     (Mac/Linux)
# =============================================
# NEVER commit the real .env file to Git!
# =============================================

# Flask secret key — used to sign session cookies
# Generate a random one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=securepay_db
